{
  "name": "pi-desktop",
  "version": "1.0.14",
  "private": true,
  "description": "Pi Agent Desktop Application - A Windows desktop app for Pi CLI",
  "keywords": [
    "pi",
    "agent",
    "desktop",
    "electron",
    "ai"
  ],
  "license": "MIT",
  "author": "Pi Desktop Contributors",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "autoInstallPeers": false,
    "overrides": {
      "dmg-builder": "^26.15.0",
      "electron-builder-squirrel-windows": "^26.15.3",
      "esbuild": "^0.28.1",
      "glob": "^10.5.0",
      "tar": "^7.5.10",
      "js-yaml": "^4.3.0",
      "fast-uri": "^3.1.4",
      "brace-expansion@2.1.1": "2.1.4",
      "brace-expansion@2.1.2": "2.1.4",
      "brace-expansion@5.0.6": "5.0.9",
      "@earendil-works/pi-coding-agent@0.78.1>undici": "^8.5.0",
      "@earendil-works/pi-agent-core": "^0.78.1",
      "@earendil-works/pi-ai": "^0.78.1",
      "@earendil-works/pi-tui": "^0.78.1",
      "eslint": "^9.39.4",
      "typescript": "^5.9.3"
    },
    "patchedDependencies": {
      "pi-openplan@1.3.0": "patches/pi-openplan@1.3.0.patch"
    }
  },
  "scripts": {
    "dev": "pnpm -r run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "clean": "pnpm -r run clean",
    "typecheck": "pnpm -r run typecheck",
    "verify:docs": "node scripts/verify-doc-facts.cjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.49.0",
    "@typescript-eslint/parser": "^8",
    "eslint-plugin-react-hooks": "^5",
    "lefthook": "^2.1.9",
    "playwright": "^1.49.0",
    "typescript-eslint": "^8"
  }
}
